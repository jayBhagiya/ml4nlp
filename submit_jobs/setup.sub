# Create the log directory listed below before submitting this job.
project_dir = /path/to/ml4nlp
data_dir = /path/to/large-storage/ml4nlp

universe = docker
docker_image = pytorch/pytorch:2.2.2-cuda11.8-cudnn8-runtime
initialdir = /path/to/home
executable = $(project_dir)/submit_jobs/run.sh
arguments = setup
environment = "PROJECT_DIR=$(project_dir) DATA_DIR=$(data_dir) VENV=$(data_dir)/venvs/graph-transformer-showcase"
should_transfer_files = NO
getenv = HOME
+WantGPUHomeMounted = true

output = $(data_dir)/logs/setup.$(ClusterId).$(ProcId).out
error = $(data_dir)/logs/setup.$(ClusterId).$(ProcId).err
log = $(data_dir)/logs/setup.$(ClusterId).$(ProcId).log

request_cpus = 4
request_memory = 12G
request_disk = 10G
request_gpus = 0

queue 1
